{
  "expo": {
    "name": "Nomi",
    "slug": "nomi-mobile",
    "scheme": "nomimobile",
    "version": "0.3.7",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nomi Mobile to access your photo library for image selection.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Nomi Mobile to access your photo library for image selection.",
          "savePhotosPermission": "Allow Nomi Mobile to save generated images to your photo library."
        }
      ],
      "expo-document-picker",
      "expo-sqlite"
    ],
    "splash": {
      "backgroundColor": "#0B1020"
    },
    "android": {
      "package": "com.nomi.mobile",
      "versionCode": 16,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#081120",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#081120",
      "barStyle": "light-content",
      "translucent": false
    },
    "ios": {
      "supportsTablet": true
    },
    "extra": {
      "eas": {
        "projectId": "7f22a256-5a17-40b3-aeb9-183d650e9e8c"
      }
    },
    "owner": "wanan_nya"
  }
}

